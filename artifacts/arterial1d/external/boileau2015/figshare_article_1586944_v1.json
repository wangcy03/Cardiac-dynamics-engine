e": "Benchmark6_ADAN56.zip", "size": 8449523, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/2386684", "supplied_md5": "efc12fc1e155c781f32b6fc12aed9769", "computed_md5": "efc12fc1e155c781f32b6fc12aed9769", "mimetype": "application/zip"}], "folder_structure": {}, "authors": [{"id": 822105, "full_name": "Etienne Boileau", "first_name": "Etienne", "last_name": "Boileau", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 822106, "full_name": "Perumal Nithiarasu", "first_name": "Perumal", "last_name": "Nithiarasu", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 822107, "full_name": "Pablo J. Blanco", "first_name": "Pablo", "last_name": "J. Blanco", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 822108, "full_name": "Lucas O. M\u00fcller", "first_name": "Lucas", "last_name": "O. M\u00fcller", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 822109, "full_name": "Fredrik Eikeland Fossan", "first_name": "Fredrik", "last_name": "Eikeland Fossan", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 822110, "full_name": "Leif Rune Hellevik", "first_name": "Leif", "last_name": "Rune Hellevik", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 822111, "full_name": "Wouter P. Donders", "first_name": "Wouter", "last_name": "P. Donders", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 176646, "full_name": "Wouter Huberts", "first_name": "Wouter", "last_name": "Huberts", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 822112, "full_name": "Marie Willemet", "first_name": "Marie", "last_name": "Willemet", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 822113, "full_name": "Jordi Alastruey", "first_name": "Jordi", "last_name": "Alastruey", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://wiley.figshare.com/articles/dataset/A_benchmark_study_of_numerical_schemes_for_one_dimensional_arterial_blood_flow_modelling/1586944", "download_disabled": false, "description": "<p>H\u00e6modynamical simulations using one-dimensional (1D) computational models exhibit many of the features of the systemic circulation under normal and diseased conditions. Recent interest in verifying 1D\u2009numerical schemes has led to the development of alternative experimental setups and the use of three-dimensional\u2009numerical models to acquire data not easily measured in vivo. In most studies to date, only one particular 1D\u2009scheme is tested. In this paper, we present a systematic comparison of six commonly used numerical schemes for 1D\u2009blood flow modelling: discontinuous Galerkin, locally conservative Galerkin, Galerkin least-squares finite element method, finite volume method, finite difference MacCormack method and a simplified trapezium rule method. Comparisons are made in a series of six benchmark test cases with an increasing degree of complexity. The accuracy of the numerical schemes is assessed by comparison with theoretical results, three-dimensional\u2009numerical data in compatible domains with distensible walls or experimental data in a network of silicone tubes. Results show a good agreement among all numerical schemes and their ability to capture the main features of pressure, flow and area waveforms in large arteries. All the information used in this study, including the input data for all benchmark cases, experimental data where available and numerical solutions for each scheme, is made publicly available online, providing a comprehensive reference data set to support the development of 1D\u2009models and numerical schemes.</p>", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 31637037, "created_date": "2015-11-06T05:24:36Z", "modified_date": "2023-05-30T11:55:17Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 2, "name": "CC0", 